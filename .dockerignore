target-wt/
.git/
.github/
.githooks/
.cline/
docs/
infra/
crates/overslash-api/tests/
node_modules/
**/node_modules/
dashboard/.svelte-kit/
dashboard/test-results/
dashboard/playwright-report/
*.md
!crates/**/README.md
!SKILL.md
.env
.env.*
docker-compose*.yml
Makefile
SCHEMA.sql
