# A template that accepts either an OAuth connection or a vaulted token
# against the same host and the same paths — the shape `services/figma.yaml`,
# `services/github.yaml` and `services/notion.yaml` ship.
openapi: 3.1.0
info:
  title: {{ display_name }}
  key: {{ key }}
servers:
  - url: https://{{ key }}.example.com
components:
  x-overslash-auth-modes:
    oauth:
      label: Sign in
      description: Connect an account.
      default: true
      schemes: [oauth]
    token:
      label: API token
      description: Paste a long-lived token.
      schemes: [token]
  securitySchemes:
    oauth:
      type: oauth2
      provider: google
      flows:
        authorizationCode:
          authorizationUrl: https://accounts.google.com/o/oauth2/v2/auth
          tokenUrl: https://oauth2.googleapis.com/token
          scopes:
            openid: ""
            email: ""
    token:
      type: http
      scheme: bearer
      x-overslash-label: API token
      default_secret_name: {{ key }}_token
security:
  - oauth: []
paths:
  /things:
    get:
      operationId: list_things
      summary: List things
      # The credential probe, and it has to work in both modes — it is what
      # gates go-live.
      test: true
      risk: read
