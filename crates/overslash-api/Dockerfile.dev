# Stage 1: generate a dependency recipe
FROM rust:1.97-slim-trixie AS chef
WORKDIR /app
# Cache toolchain layer: only re-downloaded when rust-toolchain.toml changes
COPY rust-toolchain.toml ./
RUN rustup show
RUN cargo install cargo-chef --locked
# The whole workspace, so cargo-chef derives the dependency recipe itself.
# This stage re-runs on every source change, but `prepare` only reads
# manifests — its one output, recipe.json, changes when the dependency graph
# does, which is what keeps the `deps` stage below cached.
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 2: build dependencies (cached image layer)
FROM rust:1.97-slim-trixie AS deps
WORKDIR /app
# Cache toolchain layer: only re-downloaded when rust-toolchain.toml changes
COPY rust-toolchain.toml ./
RUN rustup show
RUN apt-get update && apt-get install -y pkg-config libssl-dev clang mold && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --locked

COPY --from=chef /app/recipe.json recipe.json
COPY crates/overslash-db/migrations crates/overslash-db/migrations
COPY .sqlx .sqlx
COPY services services

ENV SQLX_OFFLINE=true
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C link-arg=-fuse-ld=mold"

RUN cargo chef cook --recipe-path recipe.json

# Stage 3: dev runtime — deps already in /app/target from the image layer
FROM rust:1.97-slim-trixie

WORKDIR /app

# Cache toolchain layer: only re-downloaded when rust-toolchain.toml changes
COPY rust-toolchain.toml ./
RUN rustup show

RUN apt-get update && apt-get install -y pkg-config libssl-dev clang mold && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-watch --locked

# Copy workspace manifests
COPY Cargo.toml Cargo.lock ./
COPY crates/overslash-core/Cargo.toml crates/overslash-core/Cargo.toml
COPY crates/overslash-db/Cargo.toml crates/overslash-db/Cargo.toml
COPY crates/overslash-api/Cargo.toml crates/overslash-api/Cargo.toml
COPY crates/overslash-mcp/Cargo.toml crates/overslash-mcp/Cargo.toml
COPY crates/overslash-cli/Cargo.toml crates/overslash-cli/Cargo.toml
COPY crates/oversla-sh/Cargo.toml crates/oversla-sh/Cargo.toml
COPY crates/overslash-metrics/Cargo.toml crates/overslash-metrics/Cargo.toml
COPY crates/overslash-metrics-exporter/Cargo.toml crates/overslash-metrics-exporter/Cargo.toml
COPY crates/overslash-mcp-puppet/Cargo.toml crates/overslash-mcp-puppet/Cargo.toml
COPY crates/overslash-fakes/Cargo.toml crates/overslash-fakes/Cargo.toml
COPY tests/mock-target/Cargo.toml tests/mock-target/Cargo.toml

# Copy migrations, sqlx cache, services
COPY crates/overslash-db/migrations crates/overslash-db/migrations
COPY .sqlx .sqlx
COPY services services

# Pre-built dependencies live in the image — no volume needed
COPY --from=deps /app/target target
COPY --from=deps /usr/local/cargo/registry /usr/local/cargo/registry

ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C link-arg=-fuse-ld=mold"

# target/ is a persistent named volume seeded from this image (prebuilt deps +
# stub-compiled overslash crates). The stub fingerprints must be cleared once so
# cargo rebuilds those crates against the real, volume-mounted source — but only
# on the first run after a fresh volume. A marker in the volume gates it, so
# subsequent container recreations skip the wipe and cargo only rebuilds on
# actual source changes (otherwise every `make dev` recompiles the world).
CMD ["sh", "-c", "if [ ! -f target/.dev-stub-cleared ]; then rm -rf target/debug/.fingerprint/overslash* target/debug/.fingerprint/mock-target* 2>/dev/null; touch target/.dev-stub-cleared; fi; cargo watch -x 'run -p overslash-cli -- serve'"]
