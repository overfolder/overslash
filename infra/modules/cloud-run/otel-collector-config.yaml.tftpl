# OTel Collector config for Cloud Run → Google Managed Prometheus.
# Scrapes the API container's `/internal/metrics` over loopback every 30s and
# ships the result to GMP as `prometheus_target` series.
# METRICS_PORT is wired to the API container's port via env on the sidecar.
receivers:
  prometheus:
    config:
      scrape_configs:
        - job_name: "app"
          scrape_interval: 30s
          metrics_path: /internal/metrics
          static_configs:
            - targets: ["localhost:$${env:METRICS_PORT}"]

processors:
  # Detects Cloud Run resource attributes (faas.name = service name,
  # faas.instance = unique per-container ID, cloud.region, etc.).
  # No-op outside GCP — falls through gracefully in local dev.
  resourcedetection/gcp:
    detectors: [gcp]
    timeout: 2s
    override: false

  resource:
    attributes:
      # Map the Cloud Run service name into service.name → GMP `job` label.
      # Without this, the Prometheus receiver's static "app" job is the only
      # disambiguator — fine today (one service) but collapses if a second
      # service ever ships with the same scrape config.
      - key: "service.name"
        from_attribute: "faas.name"
        action: upsert
      # Map the unique Cloud Run instance ID into service.instance.id →
      # GMP `instance` label. Without this, every container reports
      # instance="localhost:<port>", and concurrent containers (rolling
      # revisions, scale-up beyond min=1) collide on the same series — GMP
      # rejects the slower writer with "Points must be written in order",
      # silently dropping background-task liveness gauges.
      - key: "service.instance.id"
        from_attribute: "faas.instance"
        action: upsert
      - key: "location"
        value: "${region}"
        action: upsert
      - key: "cluster"
        value: ""
        action: upsert
      - key: "namespace"
        value: ""
        action: upsert

exporters:
  googlemanagedprometheus:
    project: ${project_id}

service:
  pipelines:
    metrics:
      receivers: [prometheus]
      processors: [resourcedetection/gcp, resource]
      exporters: [googlemanagedprometheus]
