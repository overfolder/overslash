{
  "name": "overslash-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:static": "ADAPTER=static vite build",
    "build:strict": "SVELTE_STRICT=true vite build && node scripts/check-chunk-sizes.mjs",
    "build:strict:static": "SVELTE_STRICT=true ADAPTER=static vite build && node scripts/check-chunk-sizes.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/sveltekit": "^10.5.5",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.5.4",
    "playwright": "^1.59.1",
    "simple-icons": "^16.28.0",
    "storybook": "^10.4.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "codemirror": "^6.0.2",
    "yaml": "^2.8.4"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "esbuild": "^0.28.1"
  }
}
