{
  "name": "overslash-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:static": "ADAPTER=static vite build",
    "build:strict": "SVELTE_STRICT=true vite build && node scripts/check-chunk-sizes.mjs",
    "build:strict:static": "SVELTE_STRICT=true ADAPTER=static vite build && node scripts/check-chunk-sizes.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/sveltekit": "^10.6.3",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.59.1",
    "simple-icons": "^16.35.0",
    "storybook": "^10.6.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@vercel/functions": "3.10.3",
    "codemirror": "^6.0.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "zod": "^4.6.6"
  }
}
