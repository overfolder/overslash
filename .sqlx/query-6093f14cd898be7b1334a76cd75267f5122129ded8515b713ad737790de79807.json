  "db_name": "PostgreSQL",
  "query": "SELECT u.id, u.email, u.display_name, u.overslash_idp_provider, u.overslash_idp_subject, u.personal_org_id, u.is_instance_admin, u.welcome_email_sent_at, u.welcome_emails_unsubscribed_at, u.webhook_digest_unsubscribed_at, u.created_at, u.updated_at\n         FROM users u\n         JOIN user_org_memberships m ON m.user_id = u.id\n         WHERE m.org_id = $1 AND lower(u.email) = lower($2)\n         ORDER BY u.created_at DESC\n         LIMIT 1",
