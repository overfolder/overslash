  "query": "SELECT id, event_id, org_id, type, topic, payload, audience, created_at\n           FROM events\n           WHERE org_id = $1\n             AND id > $2\n             AND ($3 OR audience && ARRAY[$4::uuid])\n             AND topic = ANY($5)\n           ORDER BY id\n           LIMIT $6",
