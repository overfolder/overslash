{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, a.org_id, a.identity_id, a.current_resolver_identity_id, a.resolver_assigned_at, a.action_summary, a.action_detail, a.disclosed_fields, a.replay_payload, a.permission_keys, a.status, a.resolved_at, a.resolved_by, a.remember, a.token, a.expires_at, a.created_at, a.tags\n         FROM approvals a\n         JOIN orgs o ON o.id = a.org_id\n         WHERE a.status = 'pending'\n           AND o.approval_auto_bubble_secs > 0\n           AND a.resolver_assigned_at < now() - make_interval(secs => o.approval_auto_bubble_secs)",
